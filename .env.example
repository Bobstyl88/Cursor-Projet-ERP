# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
NODE_ENV=development
APP_NAME=SaasERP
APP_VERSION=1.0.0

# ─────────────────────────────────────────────
# BACKEND
# ─────────────────────────────────────────────
BACKEND_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3001

# ─────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ─────────────────────────────────────────────
# MONGODB
# ─────────────────────────────────────────────
MONGO_USER=erp
MONGO_PASSWORD=erp_secret
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=erp_db
MONGO_URI=mongodb://erp:erp_secret@mongo:27017/erp_db?authSource=admin

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# ─────────────────────────────────────────────
# AUTH / JWT
# ─────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_32+_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_IN_PRODUCTION
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# ENCRYPTION
# ─────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY_HERE!!

# ─────────────────────────────────────────────
# EMAIL (SMTP)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=smtp_password
SMTP_FROM=SaasERP <no-reply@example.com>

# ─────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json
